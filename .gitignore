# =========================================
# 📦 Node / PNPM / Turborepo / Monorepo
# =========================================

# Dependencies
node_modules/
.pnpm-store/
.npm/
.pnp.*

# Turborepo cache & logs
.turbo/
turbo-dev.log
turbo-debug.log

# Build outputs
dist/
build/
.next/
out/
coverage/
.cache/
*.tsbuildinfo

# Local environment files
.env
.env.*
!.env.example

# Logs
logs/
*.log
npm-debug.log*
pnpm-debug.log*
yarn-debug.log*
yarn-error.log*

# Editor / IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Docker
**/Dockerfile.prod
docker-compose.override.yml
docker-compose.dev.yml
.docker/
*.pid

# =========================================
# 📁 App-specific ignores
# =========================================

# Next.js (Frontend)
apps/**/web/.next/
apps/**/web/out/

# NestJS (Backend)
apps/**/api/dist/
apps/**/api/.env
apps/**/api/coverage/

# =========================================
# 🧱 Packages (UI, hooks, utils, etc.)
# =========================================

packages/**/dist/
packages/**/node_modules/
packages/**/.turbo/
packages/**/.tsbuildinfo

# =========================================
# 🧰 Misc
# =========================================

# Mac / system / temp files
*.tmp
*.bak
*.local
*.orig
*.rej

# Lock files generated by IDE
*.lockb
*.iml

# Local test results
jest-html-reporters-*.html
jest-stare/

# =========================================
# 🧾 Optional: Keep examples
# =========================================

# Allow example envs
!**/.env.example
!**/README.md
